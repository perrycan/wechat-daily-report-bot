# ===== LLM 提供商 / LLM provider: openrouter | deepseek =====
LLM_PROVIDER=openrouter

# ----- OpenRouter (recommended) -----
# 在 https://openrouter.ai 申请，切勿提交真实 key 到仓库
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-5.4
OPENROUTER_FALLBACK_MODEL=openai/gpt-5.4-mini
OPENROUTER_SECOND_FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324
# 可选的元数据请求头 / optional metadata headers
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=wechat-daily-report-bot

# ----- DeepSeek (optional) -----
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-chat

# ===== 固定汇总规则文件 / fixed summary rules =====
# 支持 .md / .txt / .docx；留空则默认用仓库自带的 rules/summary_fixed_rules.md
# Supports .md/.txt/.docx; defaults to the bundled rules/summary_fixed_rules.md
LLM_FIXED_RULES_FILE=rules/summary_fixed_rules.md

# ===== 可选：从飞书在线文档拉取规则 / optional: pull rules from Feishu doc =====
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_DOC_ID=

# ===== API 服务 / API server =====
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8000

# 可选：强制指定微信后端 / force WeChat backend: wxauto | wxautox | wxautox4
# 微信 4.x 建议 wxautox4；留空则自动探测
BOT_WECHAT_BACKEND=

# true = 不操作真实微信，仅本地联调 API / mock WeChat for local API testing
BOT_DRY_RUN=true
